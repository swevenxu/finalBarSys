<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.barbershop.controller.MainController"
            styleClass="app-root">

    <top>
        <HBox styleClass="app-header" alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="12" right="18" bottom="12" left="18"/>
            </padding>
            <Label text="&#9986;" styleClass="header-logo"/>
            <Label text="BARBERSHOP MANAGEMENT SYSTEM" styleClass="app-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" styleClass="header-user"/>
            <Button text="Sign out" onAction="#handleLogout" styleClass="ghost-button"/>
        </HBox>
    </top>

    <left>
        <VBox styleClass="sidebar" spacing="3" prefWidth="196">
            <padding>
                <Insets top="16" right="12" bottom="16" left="12"/>
            </padding>
            <Label text="MENU" styleClass="sidebar-heading"/>
            <Button text="Dashboard" onAction="#showDashboard" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="Appointments" onAction="#showAppointments" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="Walk-in Queue" onAction="#showQueue" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="Customers" onAction="#showCustomers" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="Barbers" onAction="#showBarbers" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="Services" onAction="#showServices" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="Transactions" onAction="#showTransactions" styleClass="nav-button" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="10" styleClass="content-wrapper">
            <padding>
                <Insets top="16" right="18" bottom="18" left="18"/>
            </padding>
            <Label fx:id="pageTitle" text="Dashboard" styleClass="page-title"/>
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" styleClass="content-area"/>
        </VBox>
    </center>
</BorderPane>
