<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.barbershop.controller.QueueController"
      spacing="10" styleClass="screen">

    <Label text="Walk-in line (FIFO). Adding a customer calls enqueue() at the REAR; serving calls dequeue() at the FRONT."
           styleClass="dsa-note" wrapText="true"/>

    <HBox spacing="12" VBox.vgrow="ALWAYS">
        <!-- Front of the queue -->
        <VBox styleClass="panel" spacing="8" HBox.hgrow="ALWAYS">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <Label text="CURRENT CUSTOMER (FRONT)" styleClass="panel-heading"/>
            <Label fx:id="currentCustomer" text="Nobody is waiting." styleClass="nextup-value"/>
            <Label fx:id="currentDetails" text="" styleClass="muted-label"/>
            <Label fx:id="currentTicket" text="" styleClass="muted-label"/>
            <Region prefHeight="8"/>
            <Button fx:id="serveButton" text="Serve next customer &amp; take payment"
                    onAction="#handleServe" maxWidth="Infinity" styleClass="primary-button"/>
            <Button text="Remove front customer" onAction="#handleRemoveFront"
                    maxWidth="Infinity" styleClass="ghost-button"/>
        </VBox>

        <!-- Rear of the queue -->
        <VBox styleClass="panel" spacing="8" HBox.hgrow="ALWAYS">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <Label fx:id="waitingHeading" text="WAITING QUEUE" styleClass="panel-heading"/>
            <ListView fx:id="waitingList" VBox.vgrow="ALWAYS" prefHeight="220"/>
            <Label fx:id="queueStructure" text="FRONT -> empty -> REAR" styleClass="dsa-note" wrapText="true"/>
            <Button text="Remove selected customer" onAction="#handleRemoveSelected"
                    maxWidth="Infinity" styleClass="ghost-button"/>
        </VBox>
    </HBox>

    <!-- Add a walk-in -->
    <VBox styleClass="panel" spacing="6">
        <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
        <Label text="ADD WALK-IN" styleClass="panel-heading"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Customer" styleClass="field-label"/>
                <ComboBox fx:id="customerCombo" maxWidth="Infinity" promptText="Select a customer"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="New customer name (optional)" styleClass="field-label"/>
                <TextField fx:id="newCustomerField" promptText="Leave empty to use the selection above"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Service" styleClass="field-label"/>
                <ComboBox fx:id="serviceCombo" maxWidth="Infinity" promptText="Select a service"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Barber" styleClass="field-label"/>
                <ComboBox fx:id="barberCombo" maxWidth="Infinity" promptText="Select a barber"/>
            </VBox>
            <VBox spacing="4">
                <Label text=" " styleClass="field-label"/>
                <Button text="Add to queue" onAction="#handleAddWalkIn" styleClass="primary-button"/>
            </VBox>
        </HBox>
    </VBox>
</VBox>
