<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.barbershop.controller.BarberController"
      spacing="10" styleClass="screen">

    <Label text="Barbers and their availability. A barber marked Busy is skipped by the walk-in queue."
           styleClass="dsa-note" wrapText="true"/>

    <HBox spacing="12" VBox.vgrow="ALWAYS">
        <VBox styleClass="panel" spacing="8" HBox.hgrow="ALWAYS">
            <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
            <Label text="BARBERS" styleClass="panel-heading"/>
            <TableView fx:id="barberTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="220"/>
                    <TableColumn fx:id="specializationColumn" text="Specialization" prefWidth="260"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="140"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="panel" spacing="6" prefWidth="300" maxWidth="300">
            <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
            <Label fx:id="formTitle" text="NEW BARBER" styleClass="panel-heading"/>
            <Label text="Full name" styleClass="field-label"/>
            <TextField fx:id="nameField" promptText="Mark Rivera"/>
            <Label text="Specialization" styleClass="field-label"/>
            <TextField fx:id="specializationField" promptText="Fades and Tapers"/>
            <Label text="Status" styleClass="field-label"/>
            <ComboBox fx:id="statusCombo" maxWidth="Infinity"/>
            <Region prefHeight="6"/>
            <Button text="Save barber" onAction="#handleSave" maxWidth="Infinity" styleClass="primary-button"/>
            <Button text="Clear form" onAction="#handleClearForm" maxWidth="Infinity" styleClass="ghost-button"/>
            <Button text="Delete barber" onAction="#handleDelete" maxWidth="Infinity" styleClass="danger-button"/>
        </VBox>
    </HBox>
</VBox>
