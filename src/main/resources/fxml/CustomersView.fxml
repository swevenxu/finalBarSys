<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.barbershop.controller.CustomerController"
      spacing="10" styleClass="screen">

    <!-- Search bar: binary search for an exact name, linear scan for partial matches -->
    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search customer by name or phone..."
                   HBox.hgrow="ALWAYS" onAction="#handleSearch"/>
        <Button text="Search" onAction="#handleSearch" styleClass="primary-button"/>
        <Button text="Show all" onAction="#handleClearSearch" styleClass="ghost-button"/>
    </HBox>
    <Label fx:id="searchInfoLabel" styleClass="dsa-note" wrapText="true"/>

    <HBox spacing="12" VBox.vgrow="ALWAYS">
        <!-- Customer table -->
        <VBox styleClass="panel" spacing="8" HBox.hgrow="ALWAYS">
            <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
            <Label text="CUSTOMERS" styleClass="panel-heading"/>
            <TableView fx:id="customerTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="190"/>
                    <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="130"/>
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="180"/>
                    <TableColumn fx:id="countColumn" text="Appts" prefWidth="70"/>
                    <TableColumn fx:id="spentColumn" text="Total Spent" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Add / edit form -->
        <VBox styleClass="panel" spacing="6" prefWidth="300" maxWidth="300">
            <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
            <Label fx:id="formTitle" text="NEW CUSTOMER" styleClass="panel-heading"/>
            <Label text="Full name" styleClass="field-label"/>
            <TextField fx:id="nameField" promptText="Juan Dela Cruz"/>
            <Label text="Phone" styleClass="field-label"/>
            <TextField fx:id="phoneField" promptText="0917-555-0101"/>
            <Label text="Email (optional)" styleClass="field-label"/>
            <TextField fx:id="emailField" promptText="juan@example.com"/>
            <Region prefHeight="6"/>
            <Button text="Save customer" onAction="#handleSave" maxWidth="Infinity" styleClass="primary-button"/>
            <Button text="Clear form" onAction="#handleClearForm" maxWidth="Infinity" styleClass="ghost-button"/>
            <Button text="Delete customer" onAction="#handleDelete" maxWidth="Infinity" styleClass="danger-button"/>
            <Region prefHeight="4"/>
            <Button text="View history" onAction="#handleViewHistory" maxWidth="Infinity" styleClass="ghost-button"/>
        </VBox>
    </HBox>

    <!-- Service history: a custom singly linked list, newest first -->
    <VBox styleClass="panel" spacing="6" prefHeight="200" minHeight="150">
        <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
        <Label fx:id="historyTitle" text="SERVICE HISTORY — select a customer" styleClass="panel-heading"/>
        <Label fx:id="historyNote" text="History is built as a linked list: HEAD -> newest appointment -> ... -> null"
              styleClass="dsa-note" wrapText="true"/>
        <ListView fx:id="historyList" VBox.vgrow="ALWAYS"/>
    </VBox>
</VBox>
